// VAR Room database schema. Feature 3 (data model) made the first
// migration; feature 6 (sign in) added the auth tables; feature 27
// (debates API, spec 0004) added the board: categories, tags, votes
// and comments.
// Table and column names are snake_case in the database (@@map/@map)
// because the analytics queries are written in raw SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------
// FOOTBALL DATA (loaded from StatsBomb open data, feature 4)
// Ids are StatsBomb's own ids, so a second import updates rows
// instead of duplicating them.
// --------------------------------------------------------

model Competition {
  id              Int      @id // StatsBomb competition_id, e.g. 55 = UEFA Euro
  name            String
  countryName     String   @map("country_name")
  gender          String
  isInternational Boolean  @map("is_international")
  seasons         Season[]

  @@map("competitions")
}

// StatsBomb reuses a season id across competitions (282 = 2024 for both
// the Euro and Copa America), so a season is keyed by both ids together.
model Season {
  competitionId Int         @map("competition_id")
  seasonId      Int         @map("season_id")
  name          String // "2024", "2023/2024"
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches       Match[]

  @@id([competitionId, seasonId])
  @@map("seasons")
}

model Team {
  id          Int              @id // StatsBomb team_id
  name        String
  homeMatches Match[]          @relation("HomeTeam")
  awayMatches Match[]          @relation("AwayTeam")
  positions   PlayerPosition[]
  events      MatchEvent[]

  @@map("teams")
}

model Player {
  id          Int              @id // StatsBomb player_id (names are NOT unique)
  name        String
  nickname    String? // the short name fans use, e.g. "Jude Bellingham"
  countryName String?          @map("country_name")
  positions   PlayerPosition[]
  events      MatchEvent[]
  debates     Debate[]

  @@index([name])
  @@map("players")
}

model Match {
  id            Int              @id // StatsBomb match_id
  competitionId Int              @map("competition_id")
  seasonId      Int              @map("season_id")
  matchDate     DateTime         @map("match_date") @db.Date
  stage         String? // "Group Stage", "Final"
  homeTeamId    Int              @map("home_team_id")
  awayTeamId    Int              @map("away_team_id")
  homeScore     Int              @map("home_score")
  awayScore     Int              @map("away_score")
  season        Season           @relation(fields: [competitionId, seasonId], references: [competitionId, seasonId], onDelete: Cascade)
  homeTeam      Team             @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team             @relation("AwayTeam", fields: [awayTeamId], references: [id])
  positions     PlayerPosition[]
  events        MatchEvent[]

  @@index([competitionId, seasonId])
  @@map("matches")
}

// One row per stint a player spent in one position in one match. This is
// what makes "Bellingham as a 9 vs as an 8" answerable: minutes (and so
// per 90 stats) can be split by position. A player moved from CM to CF at
// minute 60 has two rows.
model PlayerPosition {
  id         Int    @id @default(autoincrement())
  matchId    Int    @map("match_id")
  playerId   Int    @map("player_id")
  teamId     Int    @map("team_id")
  position   String // StatsBomb position name, e.g. "Center Forward"
  positionId Int    @map("position_id") // StatsBomb position id, 1 to 25
  fromMinute Int    @map("from_minute")
  toMinute   Int?   @map("to_minute") // null = until the final whistle
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player     Player @relation(fields: [playerId], references: [id])
  team       Team   @relation(fields: [teamId], references: [id])

  @@index([playerId, position])
  @@index([matchId])
  @@map("player_positions")
}

// Every on ball and off ball action. StatsBomb has about 35 event types
// (Pass, Shot, Carry, Pressure, Duel, Interception, Ball Recovery, ...), so
// the type is stored as text rather than a short enum that would miss the
// defensive actions. Coordinates keep StatsBomb's 120 x 80 pitch; the UI
// converts when drawing. Zones are computed in SQL from x and y.
model MatchEvent {
  id            String  @id @db.Uuid // StatsBomb event id
  matchId       Int     @map("match_id")
  index         Int // order of the event within the match
  period        Int // 1, 2, 3 and 4 for extra time, 5 for penalties
  minute        Int
  second        Int
  type          String // "Pass", "Shot", "Pressure", ...
  teamId        Int     @map("team_id")
  playerId      Int?    @map("player_id") // null for team events like Half Start
  position      String? // the player's position at that moment
  x             Float? // 0 to 120, own goal to opponent goal
  y             Float? // 0 to 80
  endX          Float?  @map("end_x") // passes, carries, shots
  endY          Float?  @map("end_y")
  outcome       String? // e.g. "Incomplete"; null means successful for passes
  underPressure Boolean @default(false) @map("under_pressure")
  isProgressive Boolean @default(false) @map("is_progressive") // set at import, rule in metrics.ts
  xg            Float? // shots only (StatsBomb xG)
  details       Json? // small extras only (e.g. pass height, shot technique), never the raw event
  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team          Team    @relation(fields: [teamId], references: [id])
  player        Player? @relation(fields: [playerId], references: [id])

  @@unique([matchId, index])
  @@index([playerId, type])
  @@index([matchId, teamId])
  @@map("match_events")
}

// --------------------------------------------------------
// ACCOUNTS AND SESSIONS (Better Auth, feature 6, spec 0003)
// Better Auth reads and writes these through the Prisma adapter using the
// model and field names (prisma.user, emailVerified), so those follow its
// schema; @@map/@map give the real tables snake_case names.
// --------------------------------------------------------

model User {
  id              String       @id
  email           String       @unique
  emailVerified   Boolean      @default(false) @map("email_verified")
  name            String // display name, 1 to 50 characters
  image           String?
  username        String?      @unique // stored lowercase by the username plugin
  displayUsername String?      @map("display_username") // as the fan typed it
  // Never set by a request: Better Auth marks these input: false.
  role            Role         @default(USER)
  badge           Badge        @default(SPECTATOR)
  tacticalIqScore Int          @default(50) @map("tactical_iq_score")
  sessions        Session[]
  accounts        Account[]
  debates         Debate[]
  votes           DebateVote[]
  comments        Comment[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum Badge {
  SPECTATOR
  ASSISTANT_REF
  CHIEF_VAR
}

// One row per signed in device. The session cookie carries the token.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

// One row per way of signing in: "credential" (email or username plus
// password, the hash lives in password) now, "google" later.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String? // hash only, never the password itself
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

// Short lived tokens behind the confirmation and password reset links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// --------------------------------------------------------
// DEBATES AND VAR REVIEWS (the agent pipeline, feature 7)
// --------------------------------------------------------

model Debate {
  id               String           @id @default(uuid()) @db.Uuid
  authorId         String?          @map("author_id") // null once the author deletes their account
  author           User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title            String
  thesis           String
  categories       DebateCategory[] // 1 to 4 different values, checked by the API
  focusPlayerId    Int?             @map("focus_player_id") // not accepted by the API yet
  focusPlayer      Player?          @relation(fields: [focusPlayerId], references: [id])
  // Cached counters (spec 0004). Only feature 12 (votes) and feature 22
  // (comments) change them, always in the same transaction as the row.
  upVotes          Int              @default(0) @map("up_votes")
  downVotes        Int              @default(0) @map("down_votes")
  voteScore        Int              @default(0) @map("vote_score") // up_votes - down_votes
  commentCount     Int              @default(0) @map("comment_count")
  // The score of the newest COMPLETE review, null if never reviewed.
  // Only feature 25 writes it, never the model.
  credibilityScore Int?             @map("credibility_score")
  reviews          Review[]
  tags             DebateTag[]
  votes            DebateVote[]
  comments         Comment[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([authorId])
  // For the New sort: newest first, id breaks ties.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // GIN is a Postgres index for "does this array contain X" lookups.
  @@index([categories], type: Gin)
  @@map("debates")
}

enum DebateCategory {
  TACTICAL
  TRANSFER
  PLAYER
  OTHER
}

// Team and league tags. Filled only by the seed (prisma/seed.ts).
model Tag {
  id      Int         @id @default(autoincrement())
  slug    String      @unique // e.g. "bayern-munich"
  name    String // e.g. "Bayern Munich"
  kind    TagKind
  debates DebateTag[]

  @@map("tags")
}

// LEAGUE also covers the UEFA cups (Champions League, Europa League).
enum TagKind {
  TEAM
  LEAGUE
}

// Links a debate to a tag (a debate has 0 to 5 tags).
model DebateTag {
  debateId String @map("debate_id") @db.Uuid
  tagId    Int    @map("tag_id")
  debate   Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  // Restrict: a tag that is still used can't be deleted.
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([debateId, tagId])
  @@index([tagId])
  @@map("debate_tags")
}

// One up (1) or down (-1) vote per fan per debate. The migration adds a
// CHECK so the database refuses any other value. Routes come in feature 12.
model DebateVote {
  id        String   @id @default(uuid()) @db.Uuid
  debateId  String   @map("debate_id") @db.Uuid
  userId    String?  @map("user_id") // null once the voter deletes their account
  value     Int      @db.SmallInt
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([debateId, userId])
  @@map("debate_votes")
}

// A flat reply under a debate. No editing, so no updated_at.
// Routes come in feature 22.
model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  debateId  String   @map("debate_id") @db.Uuid
  authorId  String?  @map("author_id") // null once the author deletes their account
  body      String // 1 to 280 characters, checked by feature 22
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([debateId, createdAt(sort: Desc)])
  @@map("comments")
}

// One VAR check of a debate. Kept apart from Debate so a debate can be
// reviewed again, and so progress (status) is separate from the result
// (decision).
model Review {
  id               String        @id @default(uuid()) @db.Uuid
  debateId         String        @map("debate_id") @db.Uuid
  status           ReviewStatus  @default(QUEUED)
  decision         VarDecision?
  credibilityScore Int?          @map("credibility_score") // 0 to 100, computed by code
  summary          String?
  failureReason    String?       @map("failure_reason")
  model            String? // Gemini model id used
  inputTokens      Int           @default(0) @map("input_tokens")
  outputTokens     Int           @default(0) @map("output_tokens")
  costUsd          Decimal?      @map("cost_usd") @db.Decimal(10, 6)
  debate           Debate        @relation(fields: [debateId], references: [id], onDelete: Cascade)
  claims           Claim[]
  evidence         Evidence[]
  events           ReviewEvent[]
  createdAt        DateTime      @default(now()) @map("created_at")
  startedAt        DateTime?     @map("started_at")
  completedAt      DateTime?     @map("completed_at")

  @@index([debateId])
  @@index([status])
  @@map("reviews")
}

enum ReviewStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

// Shown in the UI as: Decision stands, Overturned, Check incomplete.
enum VarDecision {
  CONFIRMED
  OVERTURNED
  INCONCLUSIVE
}

// Saved progress, so the live stream can replay after a reload.
// The id doubles as the stream's event id (Last-Event-ID).
model ReviewEvent {
  id        BigInt   @id @default(autoincrement())
  reviewId  String   @map("review_id") @db.Uuid
  seq       Int // 1, 2, 3 ... within the review
  type      String // claims_extracted, tool_called, evidence_added, verdict_ready, failed
  payload   Json
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, seq])
  @@map("review_events")
}

model Claim {
  id              String          @id @default(uuid()) @db.Uuid
  reviewId        String          @map("review_id") @db.Uuid
  order           Int // position of the claim within the debate
  claimText       String          @map("claim_text")
  type            ClaimType
  entities        Json // players, teams, positions the claim mentions
  metricEvaluated String?         @map("metric_evaluated") // e.g. "progressive_carries"
  verdict         ClaimVerdict    @default(PENDING)
  confidence      Float? // 0 to 1
  reasoning       String?
  review          Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  citations       ClaimEvidence[]

  @@unique([reviewId, order])
  @@map("claims")
}

enum ClaimType {
  COMPARISON
  POSITIONAL_ROLE
  TEAM_TACTIC
  TRANSFER_FIT
  UNTESTABLE
}

enum ClaimVerdict {
  PENDING
  VERIFIED
  PARTIALLY_TRUE
  REFUTED
  INSUFFICIENT_DATA
}

// The evidence ledger: one row per real tool result the Stats Specialist
// got, written by code (never by the model). Labels are E1, E2, ...
model Evidence {
  id        String          @id @default(uuid()) @db.Uuid
  reviewId  String          @map("review_id") @db.Uuid
  label     String // "E1", "E2", ...
  toolName  String          @map("tool_name")
  args      Json
  result    Json
  lowSample Boolean         @default(false) @map("low_sample") // fewer than 90 minutes behind it
  error     String? // the tool failed; the claim cannot rest on it
  review    Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  citedBy   ClaimEvidence[]
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([reviewId, label])
  @@map("evidence")
}

// Which evidence each claim's verdict cites. The server checks every
// citation belongs to the same review before accepting a verdict.
model ClaimEvidence {
  claimId    String   @map("claim_id") @db.Uuid
  evidenceId String   @map("evidence_id") @db.Uuid
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([claimId, evidenceId])
  @@map("claim_evidence")
}
