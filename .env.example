# Copy this file to .env (git ignored) and fill in real values.
# Each variable is added by the feature that first needs it (see docs spec 0001).

# Neon "dev" branch, POOLED connection string (host contains -pooler), used by the running app.
DATABASE_URL=

# Neon "dev" branch, DIRECT connection string (same as above without -pooler), used by migrations.
DIRECT_DATABASE_URL=

# Port the API listens on locally (Railway sets it in production).
PORT=6009

# Neon "test" branch, DIRECT connection string (no -pooler). `bun test` wipes
# this branch and replays every migration before each run, so never point it
# at dev. Unset = database tests are skipped.
DATABASE_URL_TEST=

# Sign in (spec 0003). Signs session cookies: at least 32 random characters,
# generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# The API's own base URL, used in confirmation and reset links.
BETTER_AUTH_URL="http://localhost:6009"

# Production only (the API refuses to boot without them there). In development
# confirmation and reset links are printed in the API terminal instead.
# RESEND_API_KEY=""
# EMAIL_FROM="VAR Room <no-reply@yourdomain.com>"

# Gemini / Google AI (spec 0007 — VAR review agents).
# Get a key at aistudio.google.com. GEMINI_MODEL defaults to gemini-2.5-flash when unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CLI smoke test only (bun packages/agents/src/cli.ts).
# Set to the id of any existing user in your dev database.
# Not needed once the review API (feature 25) exists.
VAR_CLI_USER_ID=
